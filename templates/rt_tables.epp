<%- |
  Hash $routing_tables = {},
| -%>
# Managed by Puppet (network). Local edits are overwritten.
#
# reserved values
#
255	local
254	main
253	default
0	unspec
<% if $routing_tables.length > 0 { -%>

#
# custom tables
#
<% $routing_tables.each |$id, $name| { -%>
<%= $id %>	<%= $name %>
<% } -%>
<% } -%>
